{
  "version": "0.2.0",
  "comment": "Run/debug configs. On a remote server via VS Code Remote-SSH, these run on the server. They use the workspace .venv interpreter; build it with setup_remote.sh first.",
  "configurations": [
    {
      "name": "check_env (GPU sanity)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/check_env.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "train_mbrset.py (classifier, mBRSET in-domain)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train_mbrset.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--root",
        "${env:MBRSET_ROOT}",
        "--task",
        "dr_referable",
        "--epochs",
        "25",
        "--seed",
        "0"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "train_idrid.py (segmentation, 1 GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train_idrid.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--arch",
        "gcg_unet",
        "--amp",
        "--patch-size",
        "512",
        "--epochs",
        "200",
        "--eval-tiled",
        "--batch-size",
        "8"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "run_experiment.py (GCG vs control, 1 GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_experiment.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--seeds",
        "0",
        "1",
        "2",
        "--epochs",
        "200",
        "--patch-size",
        "512",
        "--eval-tiled",
        "--amp"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "train_idrid.py (DDP multi-GPU, torchrun)",
      "type": "debugpy",
      "request": "launch",
      "module": "torch.distributed.run",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--nproc_per_node=4",
        "${workspaceFolder}/train_idrid.py",
        "--arch",
        "gcg_unet",
        "--amp",
        "--patch-size",
        "512",
        "--epochs",
        "200",
        "--eval-tiled",
        "--batch-size",
        "16"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "1. fgadr_dataset.py (data sanity)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/fgadr_dataset.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "2. losses.py (loss sanity)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/losses.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "3. overfit_test.py (can it learn at all?)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/overfit_test.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--steps",
        "400",
        "--patch-size",
        "256"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "4. eval_fgadr.py (score a checkpoint)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval_fgadr.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--checkpoint",
        "checkpoints/gcg_seed0.pt",
        "--limit",
        "40",
        "--save-overlays",
        "out/overlays"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "4b. eval_fgadr.py (full test split, tiled @ native)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval_fgadr.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--checkpoint",
        "checkpoints/gcg_seed0.pt",
        "--tiled",
        "--tile",
        "512"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "5. export_coreml.py (on-device export)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/export_coreml.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--checkpoint",
        "checkpoints/gcg_seed0.pt",
        "--classes",
        "4",
        "--image-size",
        "512"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "pytest (full suite)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "tests/",
        "-v"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "phone sim: unit tests (CPU, ~3 min)",
      "module": "pytest",
      "args": [
        "tests/test_phone_sim.py",
        "tests/test_phone_sim_effects.py",
        "tests/test_patient_rule.py",
        "-q"
      ],
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "phone sim: effects per stage, seed 0, validation split (no training)",
      "program": "${workspaceFolder}/phone_sim_effects.py",
      "args": [
        "--profile",
        "ck_phone_sim/profile.json",
        "--source-root",
        "/data/users4/nshaik3/Datasets/BRSET/physionet.org/files/brazilian-ophthalmological/1.0.1",
        "--target-root",
        "/data/users4/nshaik3/Datasets/mBRSET/physionet.org/files/mbrset/1.0",
        "--ckpt",
        "canon_only=ck_rr_canon/seed0.pt",
        "canon_phonesim=ck_rr_phonesim/seed0.pt",
        "--num-workers",
        "5",
        "--out",
        "ck_phone_sim/effects_seed0"
      ],
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "phone sim: effects quick look (300 photos, Canon-only seed 0)",
      "program": "${workspaceFolder}/phone_sim_effects.py",
      "args": [
        "--profile",
        "ck_phone_sim/profile.json",
        "--source-root",
        "/data/users4/nshaik3/Datasets/BRSET/physionet.org/files/brazilian-ophthalmological/1.0.1",
        "--target-root",
        "/data/users4/nshaik3/Datasets/mBRSET/physionet.org/files/mbrset/1.0",
        "--ckpt",
        "canon_only=ck_rr_canon/seed0.pt",
        "--max-n",
        "300",
        "--probe-n",
        "300",
        "--num-workers",
        "5",
        "--out",
        "ck_phone_sim/effects_quick"
      ],
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "phone sim (after CK=ck_phone_sim_v3 STAGES=fit bash run_phone_sim.sh 0): referees (phone-only, mixed) + new render vs old, seed 0, validation split (no training)",
      "program": "${workspaceFolder}/phone_sim_effects.py",
      "args": [
        "--profile",
        "ck_phone_sim_v3/profile.json",
        "--source-root",
        "/data/users4/nshaik3/Datasets/BRSET/physionet.org/files/brazilian-ophthalmological/1.0.1",
        "--target-root",
        "/data/users4/nshaik3/Datasets/mBRSET/physionet.org/files/mbrset/1.0",
        "--sets",
        "render",
        "field",
        "drop",
        "--ckpt",
        "canon_only=ck_rr_canon/seed0.pt",
        "canon_phonesim=ck_rr_phonesim/seed0.pt",
        "phone=ck_phone_ceiling/seed0.pt",
        "mixed=ck_phone_mixed/seed0.pt",
        "--num-workers",
        "5",
        "--out",
        "ck_phone_sim_v3/effects_referees_seed0"
      ],
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "phone sim (after CK=ck_phone_sim_v3 STAGES=fit bash run_phone_sim.sh 0): referees + new render vs old, seeds 0-4, validation split (no training)",
      "program": "${workspaceFolder}/phone_sim_effects.py",
      "args": [
        "--profile",
        "ck_phone_sim_v3/profile.json",
        "--source-root",
        "/data/users4/nshaik3/Datasets/BRSET/physionet.org/files/brazilian-ophthalmological/1.0.1",
        "--target-root",
        "/data/users4/nshaik3/Datasets/mBRSET/physionet.org/files/mbrset/1.0",
        "--sets",
        "render",
        "field",
        "drop",
        "--ckpt",
        "canon_only=ck_rr_canon/seed0.pt",
        "phone=ck_phone_ceiling/seed0.pt",
        "mixed=ck_phone_mixed/seed0.pt",
        "canon_only=ck_rr_canon/seed1.pt",
        "phone=ck_phone_ceiling/seed1.pt",
        "mixed=ck_phone_mixed/seed1.pt",
        "canon_only=ck_rr_canon/seed2.pt",
        "phone=ck_phone_ceiling/seed2.pt",
        "mixed=ck_phone_mixed/seed2.pt",
        "canon_only=ck_rr_canon/seed3.pt",
        "phone=ck_phone_ceiling/seed3.pt",
        "mixed=ck_phone_mixed/seed3.pt",
        "canon_only=ck_rr_canon/seed4.pt",
        "phone=ck_phone_ceiling/seed4.pt",
        "mixed=ck_phone_mixed/seed4.pt",
        "--num-workers",
        "5",
        "--out",
        "ck_phone_sim_v3/effects_referees"
      ],
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
